REDIS_IMAGE=redis:7.4-alpine
PYTHON_IMAGE=python:3.12-slim
PIP_INDEX_URL=https://pypi.org/simple
NAPCAT_UID=1000
NAPCAT_GID=1000
GROUP_ENABLED=false
# V2.1 group features fail closed; add real group IDs only in the protected server .env.
GROUP_FEATURES_ENABLED=false
ALLOWED_GROUP_IDS=
BOT_OWNER_IDS=
IGNORE_BOT_IDS=
WELCOME_ENABLED=false
ASSOCIATION_LEAD_ENABLED=false
ASSOCIATION_LEAD_TARGET_QQ=
GROUP_SEND_INTERVAL_SECONDS=3
GROUP_USER_COOLDOWN_SECONDS=6
GROUP_QUEUE_SIZE=5
HANDOFF_REQUESTER_COOLDOWN_SECONDS=1800
HANDOFF_GROUP_COOLDOWN_SECONDS=600
HANDOFF_GLOBAL_PER_HOUR=3
WELCOME_WINDOW_SECONDS=20
WELCOME_STALE_SECONDS=180
GROUP_USER_LLM_PER_MINUTE=4
GROUP_USER_LLM_PER_HOUR=30
GROUP_LLM_PER_MINUTE=10
GLOBAL_LLM_CONCURRENCY=2
GROUP_DAILY_REQUEST_ATTEMPTS=300
GROUP_DAILY_INPUT_TOKENS=1000000
GROUP_DAILY_GENERATED_TOKENS=200000
GROUP_RECENT_TURNS=3
GROUP_HISTORY_CHARS=6400
GROUP_IDLE_TTL_SECONDS=1800
GROUP_ABSOLUTE_TTL_SECONDS=7200
GROUP_LLM_MAX_ATTEMPTS=2
GROUP_MAX_OUTPUT_TOKENS=800
GROUP_INPUT_TOKEN_CAP=6000
ALLOW_PRIVATE=true
USER_COOLDOWN_SECONDS=5
GLOBAL_SEND_INTERVAL_SECONDS=1.5
LLM_TIMEOUT_SECONDS=45
LLM_MAX_ATTEMPTS=3
MAX_INPUT_CHARS=4000
MAX_OUTPUT_CHARS=2000
QQ_PART_LIMIT=4000
MAX_ANSWER_PARTS=2
CONTEXT_TURNS=8
CONTEXT_MAX_CHARS=16000
HISTORY_RETENTION_DAYS=30
MAX_PENDING_MESSAGES=32
RECOVERY_LOCAL_ENABLED=true
RECOVERY_HISTORY_ENABLED=false
RECOVERY_PENDING_TTL_SECONDS=7200
RECOVERY_AUTOMATIC_AGE_SECONDS=900
RECOVERY_MAX_TOPICS_PER_EPOCH=3
RECOVERY_MAX_TOPICS_PER_USER_EPOCH=1
RECOVERY_SEND_INTERVAL_SECONDS=10
RECOVERY_MAX_ANSWER_PARTS=2
