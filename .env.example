COMPOSE_PROJECT_NAME=qq-ai-bot
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
LLM_PROVIDER=deepseek
POSTGRES_USER=qqbot
POSTGRES_DB=qqbot
POSTGRES_PASSWORD=
REDIS_PASSWORD=
ONEBOT_ACCESS_TOKEN=
WEBUI_TOKEN=
APP_SECRET=
NAPCAT_IMAGE=mlikiowa/napcat-docker:latest
